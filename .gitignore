# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# playwright-mcp artifacts (debug snapshots/console logs)
.playwright-mcp/

# Claude Code internal state (/loop scheduling, etc.)
.claude/scheduled_tasks.lock

# generated service worker (built from src/sw.template.js)
public/sw.js

# generated iOS PWA splash images (regenerated by scripts/generate-ios-splash.mjs on build)
public/icons/splash/

# legacy files
/_legacy/

# typescript
*.tsbuildinfo
next-env.d.ts
reference/
pnpm-lock.yaml
