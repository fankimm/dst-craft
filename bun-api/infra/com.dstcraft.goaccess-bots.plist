<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.dstcraft.goaccess-bots</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/fankimm/works/dst-craft/bun-api/infra/goaccess-bots.sh</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

