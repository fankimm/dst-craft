// ---------------------------------------------------------------------------
// 요리솥 시뮬레이터 "가능한 요리" 표 생성 (#137)
//   node --import ./scripts/ts-import-hooks.mjs ./scripts/generate-cookpot-reachable.mts [--check]
//
// 재료 1개만 넣은 상태의 후보 계산은 남은 3칸 조합 ~12만 개를 전부 돌려야 해서 0.3~0.5초(데스크톱)가
// 걸린다. 그 경우만 여기서 미리 계산해 src/data/cookpot-reachable.ts에 정렬된 레시피 인덱스 문자열로 저장한다.
// 2~3개 넣은 경우는 런타임 계산이 충분히 빠르다(≤10ms).
//
// **recipeTests(cookpot-engine.ts)·recipes.ts·cookpot-ingredients.ts를 바꾸면 다시 돌릴 것.**
// 레시피 목록·재료 id가 어긋나면 엔진이 표를 버리고 런타임 계산으로 돌아가므로(개발 모드는 throw)
// 틀린 결과가 나오진 않지만, 테스트 함수 로직만 바뀐 건 id로 감지할 수 없다 — `--check`로 대조한다.
// ---------------------------------------------------------------------------
import fs from "node:fs";
import path from "node:path";
import { fileURLToPath } from "node:url";
import { cookingRecipes } from "@/data/recipes";
import { cookpotIngredients } from "@/data/cookpot-ingredients";
import { _computeReachableRecipes, encodeRecipeOrder, type Station } from "@/lib/cookpot-engine";

const OUT = path.resolve(path.dirname(fileURLToPath(import.meta.url)), "../src/data/cookpot-reachable.ts");
const STATIONS: Station[] = ["cookpot", "portablecookpot"];
const check = process.argv.includes("--check");

const started = performance.now();
const table: Record<Station, Record<string, string>> = { cookpot: {}, portablecookpot: {} };
for (const station of STATIONS) {
  for (const ing of cookpotIngredients) {
    const recipes = _computeReachableRecipes([ing], station);
    table[station][ing.id] = encodeRecipeOrder(recipes);
  }
  process.stderr.write(`${station}: ${cookpotIngredients.length} ingredients done (${((performance.now() - started) / 1000).toFixed(0)}s)\n`);
}

const body = `// ---------------------------------------------------------------------------
// AUTO-GENERATED by scripts/generate-cookpot-reachable.mts — DO NOT EDIT.
// 재료 1개만 넣었을 때 "아직 될 수 있는 요리"(#137) — 화면 순서대로 recipeIds 인덱스(base36 두 글자씩).
// Re-run: node --import ./scripts/ts-import-hooks.mjs ./scripts/generate-cookpot-reachable.mts
// recipeTests·recipes.ts·cookpot-ingredients.ts 변경 시 재생성. --check 로 대조.
// ---------------------------------------------------------------------------

export const cookpotReachableSingle = {
  /** 생성 시점의 cookingRecipes id 순서 — 런타임 목록과 다르면 엔진이 이 표를 무시한다 */
  recipeIds: ${JSON.stringify(cookingRecipes.map((r) => r.id))},
  cookpot: ${JSON.stringify(table.cookpot, null, 2).replace(/\n/g, "\n  ")},
  portablecookpot: ${JSON.stringify(table.portablecookpot, null, 2).replace(/\n/g, "\n  ")},
} as const;
`;

if (check) {
  const current = fs.existsSync(OUT) ? fs.readFileSync(OUT, "utf8") : "";
  if (current !== body) {
    console.error(`MISMATCH: ${OUT} is stale — re-run without --check`);
    process.exit(1);
  }
  console.log("OK: cookpot-reachable.ts matches current engine");
} else {
  fs.writeFileSync(OUT, body);
  console.log(`wrote ${OUT} (${(body.length / 1024).toFixed(1)} KB)`);
}
