{
  "ignoreCommand": "bash scripts/vercel-ignore.sh",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "https://beta.dstcraft.com/api/$1" }
  ],
  "headers": [
    {
      "source": "/ko",
      "headers": [{ "key": "Content-Language", "value": "ko" }]
    },
    {
      "source": "/ko/(.*)",
      "headers": [{ "key": "Content-Language", "value": "ko" }]
    }
  ]
}
